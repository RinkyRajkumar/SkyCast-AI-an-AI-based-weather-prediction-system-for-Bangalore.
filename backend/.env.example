# Runtime port. Render supplies PORT automatically.
PORT=8000

# Comma-separated exact origins. Add the production Vercel domain here.
SKYCAST_CORS_ORIGINS=http://localhost:5173,https://your-skycast-app.vercel.app

# Optional preview-deployment pattern. Leave blank to allow exact origins only.
SKYCAST_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
SKYCAST_CORS_ALLOW_CREDENTIALS=false

# Optional paths, resolved from the project root when Uvicorn is run there.
SKYCAST_MODELS_ROOT=models
SKYCAST_REPORTS_ROOT=reports
